# Скопируйте в .env и поправьте под себя. Все ключи читает backend/app/config.py.

APP_ENV=dev
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# База данных (SQLite по умолчанию; можно PostgreSQL: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./data/abp.db
SECRET_KEY=замените-на-длинную-случайную-строку
ACCESS_TOKEN_MINUTES=30
MAX_LOGIN_FAILURES=5
LOCKOUT_MINUTES=15
ALLOW_REGISTRATION=true

# Поиск: auto — OpenSearch, если доступен, иначе индекс в памяти; opensearch — только OpenSearch; memory — только память
SEARCH_BACKEND=auto
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=abp-docs
OPENSEARCH_RETRIES=3

# Папка с документами, загружаемая при старте (относительно backend/)
DOCS_DIR=../sample-docs

# СМС: console — код пишется в журнал; http — POST {phone, text} на шлюз
SMS_PROVIDER=console
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_CODE_MINUTES=5

# Искусственный интеллект: mock — без сети; openai — совместимый API (OpenAI, OpenRouter, Ollama); anthropic
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TOP_K=6
AI_STRICT_CITATIONS=true
AI_TIMEOUT_SECONDS=60

# Клиент
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Адрес API для клиента Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
